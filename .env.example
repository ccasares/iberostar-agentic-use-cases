# Copy to .env.local and fill in. Only the SMTP block is required to sign in;
# everything else has a sensible default for local testing.

# --- Email verification gate (required to receive a sign-in code) -------------
# No corporate mail relay? Any of the free tiers under "Free SMTP providers" in
# README.md works — uncomment one of the presets below instead of this block.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Demo Portal
SMTP_FROM_EMAIL=

# --- Free SMTP presets (uncomment one, replace the block above) ---------------
# Sign-in emails are low volume — one 6-digit code per visitor — so every free
# tier below is comfortably enough for a demo. Port 465 also works; the route
# switches to implicit TLS automatically when SMTP_PORT is 465.
#
# Brevo — 300/day, no expiry, no card. Free tier appends a Brevo footer.
#   SMTP_USER is the login email shown on the SMTP & API page, SMTP_PASSWORD the
#   generated SMTP key (not your account password).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=<brevo-smtp-key>
#
# Resend — 3,000/month (100/day). SMTP_USER is the literal string "resend".
#   Needs a verified domain; until then it only delivers to your own address.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=<resend-api-key>
#
# Mailjet — 6,000/month (200/day). User/password are the API key pair.
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=<mailjet-api-key>
# SMTP_PASSWORD=<mailjet-secret-key>
#
# Gmail — 500/day. Requires 2-step verification plus an App Password; a normal
#   account password is rejected. Fine for a demo, not for a customer-facing one.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<16-char-app-password>
#
# Mailtrap Sandbox — local testing only. Codes land in the Mailtrap inbox and
#   are never delivered, so use it to prove the gate works, not for a live demo.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=<mailtrap-username>
# SMTP_PASSWORD=<mailtrap-password>

# --- Branding ----------------------------------------------------------------
# Rendered in the verification email header and footer.
BRAND_NAME="Grupo Iberostar"

# --- Access control ----------------------------------------------------------
# Comma-separated domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=iberostar.com,grupoiberostar.com
# Domain whose users can see engagement and sign-in activity.
ADMIN_EMAIL_DOMAIN=iberostar.com
# Client-side mirror of ADMIN_EMAIL_DOMAIN — must match it.
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=iberostar.com
# Domain whose viewer activity is surfaced to admins.
TRACKED_EMAIL_DOMAIN=iberostar.com
# Comma-separated emails allowed to configure broker URLs from the Chat tab.
BROKER_CONFIG_ADMIN_EMAIL=admin@iberostar.com

# --- Optional use-case tabs --------------------------------------------------
# AI Governance and LLM Gateway are demo tabs: every figure on them is generated
# from the use-case slug, not reported by a broker. Convincing in a demo, wrong
# in front of an audience who will take them for real telemetry — so either can
# be switched off. Blank or unset keeps whatever the generator baked into
# lib/portal-tabs.ts from the input prompt; false wins over it.
# NEXT_PUBLIC_ENABLE_GOVERNANCE_TAB=false
# NEXT_PUBLIC_ENABLE_LLM_GATEWAY_TAB=false

# --- Storage -----------------------------------------------------------------
# Where likes, views, and broker config are persisted. Ephemeral on Railway
# unless a volume is mounted.
STATS_DIR=./.data
# Optional JSON map of slug -> broker URL, shared across instances.
# BROKER_CONFIG_JSON={"my-use-case":"https://ingress.example.com/my-broker"}
